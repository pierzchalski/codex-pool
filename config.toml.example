# Codex Pool Proxy Configuration
# Copy this file to config.toml (or container-config/config.toml for docker-compose)
# and customize as needed. Environment variables override file values.

# Server settings
listen_addr = "127.0.0.1:8989"
pool_dir = "pool"
db_path = "./data/proxy.db"
max_attempts = 3
disable_refresh = false
debug = false

# Public URL used in generated setup scripts and links.
# Leave blank to infer from the incoming request.
# public_url = "https://pool.example.com"
public_url = ""

# Optional selection tuning for preferred tiers.
# Defaults to 0.50 if unset.
# tier_threshold = 0.50

# Enables /admin/* endpoints.
# If blank, /admin/* returns "admin access disabled".
admin_token = ""
# admin_token_file = "./secrets/admin_token"

# Optional self-serve landing page for friends.
friend_code = ""
# friend_code_file = "./secrets/friend_code"
friend_name = ""
friend_tagline = ""

# Pool-user mode settings.
# Generated Codex / Claude / Gemini client credentials require jwt_secret.
[pool_users]
# Secret used to sign pool-user tokens. Use a long random value.
jwt_secret = ""
# jwt_secret_file = "./secrets/pool_users_jwt_secret"

# Where to store generated pool users.
storage_path = "./data/pool_users.json"
